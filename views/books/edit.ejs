<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit <%= book.name %> | Bookshelf</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="page">
    <nav class="topbar">
      <a class="brand" href="/">Bookshelf</a>
      <div class="topbar__links">
        <a href="/books">All books</a>
      </div>
    </nav>

    <main class="container narrow">
      <header class="page-head">
        <div>
          <p class="eyebrow">Edit book</p>
          <h1>Update "<%= book.name %>"</h1>
        </div>
        <a class="btn ghost" href="/books/<%= book._id %>">Back</a>
      </header>

      <form class="form" action="/books/<%= book._id %>?_method=PUT" method="POST">
        <label class="field">
          <span>Book name</span>
          <input type="text" name="name" value="<%= book.name %>" required />
        </label>

        <label class="toggle">
          <input type="checkbox" name="isReadyToRead" <%= book.isReadyToRead ? 'checked' : '' %> />
          <span>Ready to read</span>
        </label>

        <div class="form__actions">
          <a class="btn ghost" href="/books/<%= book._id %>">Cancel</a>
          <button class="btn primary" type="submit">Save changes</button>
        </div>
      </form>
    </main>
  </body>
</html>
