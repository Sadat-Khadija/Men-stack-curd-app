<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Books | Bookshelf</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="page">
    <nav class="topbar">
      <a class="brand" href="/">Bookshelf</a>
      <div class="topbar__links">
        <a href="/books">All books</a>
        <a class="btn primary" href="/books/new">Add book</a>
      </div>
    </nav>

    <main class="container">
      <header class="page-head">
        <div>
          <p class="eyebrow">Library</p>
          <h1>All books</h1>
          <p class="muted">Click a title to view details or update its status.</p>
        </div>
        <a class="btn primary" href="/books/new">Add a book</a>
      </header>

      <section class="grid">
        <% books.forEach(book => { %>
          <article class="card">
            <div class="card__row">
              <a class="card__title" href="/books/<%= book._id %>"><%= book.name %></a>
              <span class="badge <%= book.isReadyToRead ? 'ready' : 'pending' %>">
                <%= book.isReadyToRead ? 'Ready to read' : 'Not yet' %>
              </span>
            </div>
            <div class="card__actions">
              <a class="btn ghost small" href="/books/<%= book._id %>/edit">Edit</a>
              <form action="/books/<%= book._id %>?_method=DELETE" method="POST" class="inline-form">
                <button class="btn danger small" type="submit">Delete</button>
              </form>
            </div>
          </article>
        <% }) %>

        <% if (!books.length) { %>
          <div class="empty">
            <p class="muted">No books yet. Start by adding one.</p>
            <a class="btn primary" href="/books/new">Add your first book</a>
          </div>
        <% } %>
      </section>
    </main>
  </body>
</html>
